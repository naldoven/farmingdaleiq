NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_ACCESS_TOKEN=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=
# Shared secret for scheduled-job route handlers (app/api/cron/*), e.g.
# app/api/cron/checklists, app/api/cron/training, app/api/cron/maintenance.
# Vercel Cron sends this automatically as "Authorization: Bearer
# $CRON_SECRET" when configured.
CRON_SECRET=

# Guest Recovery (ARCHITECTURE.md "Guest Recovery"). Email goes through Resend
# from a store-owned domain; texts go through Twilio. Texting stays off until
# GUEST_SMS_ENABLED is exactly "true" (carrier registration takes days).
# NEXT_PUBLIC_APP_URL is the address guests' links point at; without it the
# Vercel production address is used.
NEXT_PUBLIC_APP_URL=
# Beta email: the store's Gmail account with a Google app password. Used only
# when RESEND_API_KEY and GUEST_EMAIL_FROM are not both set.
GMAIL_USER=
GMAIL_APP_PASSWORD=
RESEND_API_KEY=
GUEST_EMAIL_FROM=
GUEST_EMAIL_REPLY_TO=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
GUEST_SMS_ENABLED=
